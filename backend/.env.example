# ─── Database ─────────────────────────────────────────────────────────────────
# Railway: copy the Internal Database URL from your Postgres service variables.
# Local:   postgresql://postgres:postgres@localhost:5432/yotweek
DATABASE_URL="postgresql://user:password@localhost:5432/yotweek?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed frontend origins. On Railway, set this to
# your frontend service's public URL, e.g. https://yotweek-frontend.up.railway.app
FRONTEND_URL="http://localhost:3000"

# ─── Image uploads (Railway Bucket) ────────────────────────────────────────────
# Uploaded listing/highlight photos and videos are stored in a Railway Bucket
# (S3-compatible), NOT on local disk — Railway's container filesystem is
# ephemeral and wipes uploads on every redeploy/restart/scale. Attach a
# Bucket to this service in the Railway dashboard, then either use a
# Variable Reference to its credentials, or run `railway bucket credentials`
# and paste the AWS_* values below.
AWS_ENDPOINT_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_DEFAULT_REGION="auto"
# "virtual" (default, bucket name as endpoint subdomain) or "path" — the
# bucket's Credentials tab in Railway tells you which one it needs.
AWS_S3_URL_STYLE="virtual"

# Local-dev-only fallback: if the AWS_* vars above are left blank, uploads
# fall back to local disk at this path (defaults to ./uploads). Never rely
# on this in production — see utils/s3.ts.
UPLOAD_DIR=""
# Only needed if you put a CDN/reverse proxy in front of this API — otherwise
# upload URLs are built from the incoming request's own host automatically.
PUBLIC_UPLOAD_BASE_URL=""

# ─── Payments ─────────────────────────────────────────────────────────────────
# Wire in Flutterwave, Pesapal, or DPO credentials here.
PAYMENT_PROVIDER_API_KEY=""
PAYMENT_PROVIDER_SECRET=""
PLATFORM_COMMISSION_PCT=5

# ─── Email (optional) ─────────────────────────────────────────────────────────
# Leave SMTP_HOST blank in development — emails are logged to console instead.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="yotweek <no-reply@yotweek.com>"
